+    // above the paper-level recall even though the paper line is older.
+    const { items } = assembleRecall({
+      recalled: [
+        row({ id: "older", paperId: "paper_2", createdAt: NOW - 300 * DAY }),
+        row({ id: "same-passage" }),
+      ],
