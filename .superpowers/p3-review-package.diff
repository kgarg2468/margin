+
+const titles = new Map([
+  ["paper_1", "Cold-chain effects"],
+  ["paper_2", "Freeze–thaw and yield"],
+]);
+
+describe("assembleRecall", () => {
+  it("speaks in the first person and dates what it hands back", () => {
+    const { items } = assembleRecall({
+      recalled: [row({ id: "a" })],
+      fresh: [],
+      paperTitles: titles,
