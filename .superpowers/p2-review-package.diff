+  const ctx = new FakeCtx();
+  const seed = await seedLab(ctx);
+  ctx.auth = { userId: seed.pi };
+  await ctx.db.patch(seed.paperId, { storageId: "storage_seed" });
+  return { ctx, ...seed };
